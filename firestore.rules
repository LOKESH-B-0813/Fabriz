rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username reservation collection for enforcing unique usernames
    match /usernames/{username} {
      // Authenticated users can check availability
      allow read: if request.auth != null;
      // Allow user to claim username if document contains their own uid
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Allow user to release their username when deleting account
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Scoped User Private Space
    match /users/{userId} {
      // User profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /history/{eventId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Notes subcollection (Personal Knowledge)
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Vault subcollection (Encrypted Passwords)
      match /vault/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Encrypted Password Manager configuration and canary metadata
      match /vault_meta/{configId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
